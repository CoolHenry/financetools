.container {
    min-height: 100vh;
    background: linear-gradient(to bottom, #42A5F5, #B2FF59);
    padding: 20rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.timer {
    background-color: #FFCC80;
    color: #F57C00;
    padding: 10rpx 20rpx;
    border-radius: 20rpx;
    font-size: 32rpx;
    font-weight: bold;
    text-align: center;
    box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
    margin-bottom: 20rpx;
}

.timer.warning {
    background-color: #FF5252;
    color: #FFFFFF;
    animation: blink 1s infinite;
}

@keyframes blink {
    50% {
        opacity: 0.6;
    }
}

.board {
    position: relative;
    width: 700rpx;
    height: 700rpx;
    background-color: #FFF9C4;
    border: 2rpx solid #BDBDBD;
    border-radius: 20rpx;
    box-shadow: inset 0 0 10rpx rgba(0, 0, 0, 0.1);
    margin: 20rpx auto;
}

.item {
    position: absolute;
    width: 100rpx;
    height: 100rpx;
    box-shadow: 6rpx 6rpx 12rpx rgba(0, 0, 0, 0.3);
    border: 2rpx solid #E0E0E0;
    transition: transform 0.3s;
    border-radius: 12rpx;
}

.item:hover {
    transform: perspective(500px) scale(1.05) rotate( {
                {
                item.rotation
            }
        }

        deg);
}

.slots {
    display: flex;
    justify-content: center;
    margin-top: 20rpx;
}

.slot {
    width: 80rpx;
    height: 80rpx;
    border: 2rpx solid #F06292;
    background-color: #F8BBD0;
    margin: 0 10rpx;
    border-radius: 12rpx;
    box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.empty {
    background-color: #E0E0E0;
}

.button-area {
    display: flex;
    justify-content: center;
    margin-top: 20rpx;
}

.button {
    background: linear-gradient(to bottom, #FF9800, #F57C00);
    color: #FFFFFF;
    padding: 15rpx 30rpx;
    margin: 0 20rpx;
    font-size: 28rpx;
    border-radius: 15rpx;
    box-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.3);
    transition: all 0.2s;
}

.button:hover {
    background: linear-gradient(to bottom, #F57C00, #E64A19);
    box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
    transform: translateY(2rpx);
}